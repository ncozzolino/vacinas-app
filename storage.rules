rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil: qualquer um pode ler (é uma URL de imagem, como a
    // foto do Google), mas só o dono da conta pode escrever a própria.
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
